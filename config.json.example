{
  "version": 1,
  "set_time": "2026-07-15T12:00:00Z",
  "home_zone": "Europe/Berlin",
  "start_page": 1,
  "night_from": 18,
  "night_to": 6,
  "sync_interval_min": 15,
  "refresh_interval_min": 3,
  "night_refresh_min": 0,
  "combo_days": 7,
  "lang": "en",
  "ha_url": "http://homeassistant.local:8123",
  "ha_token": "REPLACE_WITH_LONG_LIVED_TOKEN",
  "config_url": "http://homeassistant.local:8123/local/reterminal/config.json",
  "show_pages": [true, true, true, true, true, true, true, true, true, false],
  "bar_skip_pages": "7,8",
  "auto_cycle": false,
  "radio": true,
  "bar_solar_hijri": true,
  "bar_lunar_hijri": false,
  "bar_climate": true,
  "bar_font_size": 20,
  "battery_bar": false,
  "dial_photos": true,
  "night_mode": true,
  "analog_offsets": true,
  "analog_labels_inside": false,
  "columns": [
